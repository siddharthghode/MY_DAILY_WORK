# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database Configuration (PostgreSQL in production/Docker, SQLite default for local dev)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=object_storage_db
# DB_USER=storage_user
# DB_PASSWORD=storage_password
# DB_HOST=db
# DB_PORT=5432

# S3 / MinIO Object Storage Configuration
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=my-storage-bucket
AWS_S3_REGION_NAME=us-east-1
# Set AWS_S3_ENDPOINT_URL for MinIO, LocalStack, or Cloudflare R2:
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=private
AWS_S3_SIGNATURE_VERSION=s3v4

# Storage Upload Policies
UPLOAD_MAX_FILE_SIZE_BYTES=5368709120  # 5 GB
BACKEND_MEDIATED_MAX_BYTES=10485760    # 10 MB limit for backend-mediated uploads
DEFAULT_PART_SIZE_BYTES=10485760       # 10 MB per multipart chunk
MIN_PART_SIZE_BYTES=5242880            # 5 MB (S3 minimum)
PRESIGNED_URL_EXPIRY_SECONDS=3600      # 1 hour
DOWNLOAD_URL_EXPIRY_SECONDS=900        # 15 minutes

# Optional CDN Configuration
CDN_BASE_URL=https://cdn.example.com
CDN_KEY_PAIR_ID=
CDN_PRIVATE_KEY_PATH=

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Observability
LOG_LEVEL=INFO
